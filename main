#!/bin/bash

#SBATCH --job-name=app
#SBATCH --ntasks-per-node=1
#SBATCH --mem=32G
#SBATCH --time=24:00:00

# brainlife.io entrypoint.
# Runs inside gamorosino/app-cmc-invivo-nordic:v1.0, which layers Python
# NORDIC dependencies on top of swarrington1/cmc-invivo:v0.1.0.

set -e

mkdir -p out_dir

singularity exec -e --nv docker://ghcr.io/gamorosino/app-cmc-invivo-nordic:v1.0 python3 main.py

[ -z "$(ls -A out_dir)" ] && echo "no output produced" && exit 1
exit 0
